# Copia a backend/.env (gitignored). ./dev.sh lo crea solo y genera MC_TOKEN si falta.
GIN_MODE=release
APP_NAME=master-control
BUCKET_NAME=actions

# Token obligatorio para toda la API (salvo /health). Vacío = uno efímero por ejecución.
# Generar: openssl rand -hex 24
MC_TOKEN=

# Dónde escucha el backend. 127.0.0.1 = solo esta Mac; la IP de Tailscale = tu tailnet.
# ./dev.sh --tailscale / --lan lo fija por ti.
MC_HOST=127.0.0.1
MC_PORT=8080

# Orígenes de la UI permitidos por CORS, separados por coma. Vacío = todos (el token sigue siendo obligatorio).
MC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tope en segundos para el timeout_seconds de cualquier acción.
MC_MAX_TIMEOUT=120
